# ============================================================
# Algorithms — parent repo .gitignore
# Subprojects (graph_algo, search_algo, sort_algo, UI_repo) are
# directories in this monorepo and carry their own .gitignore for build output.
# The entries below also apply to any stray artifacts at this level.
# ============================================================

# ---- Build output ----
build/
build-*/
out/
cmake-build-*/
x64/
Win32/
Debug/
Release/

# ---- CMake ----
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
CMakeUserPresets.json
CMakeLists.txt.user

# ---- Compiler / linker artifacts ----
*.o
*.obj
*.exe
*.dll
*.a
*.lib
*.pdb
*.idb
*.ifc
*.recipe

# ---- Qt / Qt Creator ----
*.autosave
*.qmlc
*.jsc
*.user
.qtcreator/

# ---- Editor / tooling ----
.vscode/
.vs/
.claude/
.idea/

# ---- OS cruft ----
Thumbs.db
Desktop.ini
.DS_Store
